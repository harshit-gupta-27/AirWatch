# MongoDB
MONGODB_URI=

# API port (3001 — avoid 5000 on macOS, AirPlay uses it)
PORT=3001

# Optional: chatbot
OPENAI_API_KEY=your_openai_api_key_here

# Required for live AQI: https://aqicn.org/api/
AQICN_TOKEN=your_aqicn_token_here

# Frontend. Leave as /api when using `npm run dev` (Vite proxies to the API).
VITE_API_URL=/api
